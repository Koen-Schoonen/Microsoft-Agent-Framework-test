# Copy this file to .env and fill in the values you use.
# Do not commit your real secrets to source control.

# Default to the signed-in Ollama cloud model for easier startup on smaller PCs.
# If you want a local model instead, change it to gemma4:e2b and run:
#   ollama pull gemma4:e2b
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma4:cloud

# If you prefer the fully local flow, use:
# OLLAMA_MODEL=gemma4:e2b

# You can add other provider settings here later, for example:
# OPENAI_API_KEY=your_key_here
# OPENAI_MODEL=gpt-4o-mini
